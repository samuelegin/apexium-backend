PORT=3000
JWT_SECRET=change-me-in-production
DATABASE_PATH=database.sqlite

# When deploying to Railway, set API_BASE_URL to the full API prefix:
# API_BASE_URL=https://your-railway-app-url.railway.app/api
API_BASE_URL=http://localhost:3000/api

# Frontend URL for OAuth redirects back to your app:
# FRONTEND_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email configuration (for email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@apexium.com

# Telegram Bot (for Telegram authentication)
# Create a Telegram bot via @BotFather and get these values
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username

# Discord OAuth2 (for Discord authentication)
# Create an OAuth2 app at https://discord.com/developers/applications
# Set Redirect URI to: http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret